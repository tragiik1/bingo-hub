<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads the game with the Randomizer's own libraries. make.ps1 extracts them into .\extracted. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>item-icons</AssemblyName>
    <DllDir Condition="'$(DllDir)'==''">$(MSBuildThisFileDirectory)extracted</DllDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="defs\*.xml" CopyToOutputDirectory="PreserveNewest" LinkBase="defs" />
    <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
    <Reference Include="SoulsFormats"><HintPath>$(DllDir)\SoulsFormats.dll</HintPath></Reference>
    <Reference Include="FSParam"><HintPath>$(DllDir)\FSParam.dll</HintPath></Reference>
    <Reference Include="Randomizer"><HintPath>$(DllDir)\Randomizer.dll</HintPath></Reference>
    <Reference Include="ZstdNet"><HintPath>$(DllDir)\ZstdNet.dll</HintPath></Reference>
    <Reference Include="ICSharpCode.SharpZipLib"><HintPath>$(DllDir)\ICSharpCode.SharpZipLib.dll</HintPath></Reference>
    <Reference Include="BouncyCastle.Cryptography"><HintPath>$(DllDir)\BouncyCastle.Cryptography.dll</HintPath></Reference>
    <Reference Include="StudioUtils"><HintPath>$(DllDir)\StudioUtils.dll</HintPath></Reference>
    <Reference Include="DrSwizzler"><HintPath>$(DllDir)\DrSwizzler.dll</HintPath></Reference>
  </ItemGroup>
</Project>
